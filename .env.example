# ─────────────────────────────────────────────────────────────────────────────
# PSMS environment variables
#
# Every variable used by any process is declared here with a comment explaining
# what it is and which file consumes it. The API refuses to start if a required
# variable is missing.
#
# Local dev: copy to .env.local. Staging/prod: source from host secret store.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development                         # apps/api/src/lib/env.ts
PORT=3000                                    # apps/api/src/index.ts
LOG_LEVEL=info                               # apps/api/src/lib/logger.ts (trace|debug|info|warn|error)

# ── Database ────────────────────────────────────────────────────────────────
# Connection string for Postgres. Used by Prisma client + migrations.
DATABASE_URL=postgresql://psms:psms@localhost:5432/psms?schema=public

# ── Sessions / cookies ──────────────────────────────────────────────────────
# 32+ bytes of random material. Used by apps/api/src/middleware/session.ts.
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-48-bytes-of-base64-randomness
SESSION_COOKIE_NAME=psms_session
SESSION_TTL_HOURS=8                          # idle timeout

# ── Magic links (PRC-03) ────────────────────────────────────────────────────
MAGIC_LINK_TTL_HOURS=24
MAGIC_LINK_MAX_ACTIVE_PER_SUPERVISOR=3
# Public origin used in magic-link emails (no trailing slash).
PUBLIC_WEB_ORIGIN=http://localhost:5173

# ── Email (SendGrid) ────────────────────────────────────────────────────────
# Local dev points at Mailpit (docker-compose). Production uses SendGrid API.
SENDGRID_API_KEY=                            # leave empty in dev to fall back to SMTP
SMTP_HOST=localhost                          # mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@psms.knox.edu.jm
EMAIL_FROM_NAME=Knox PSMS
SENDGRID_WEBHOOK_PUBLIC_KEY=                 # base64 ECDSA public key from SendGrid console

# ── Certificate signing (PRC-06) ────────────────────────────────────────────
# Ed25519 private key, base64 encoded. NEVER COMMIT. Generate with:
#   node -e "const c=require('crypto'); const k=c.generateKeyPairSync('ed25519'); \
#     console.log('PRIV='+k.privateKey.export({type:'pkcs8',format:'pem'})); \
#     console.log('PUB='+k.publicKey.export({type:'spki',format:'pem'}));"
CERT_SIGNING_KEY=
CERT_PUBLIC_KEY=

# ── File storage ────────────────────────────────────────────────────────────
# S3-compatible object store for CV uploads, MOU PDFs, signed certificates.
# Local dev uses MinIO (docker-compose).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=psms-uploads
S3_FORCE_PATH_STYLE=true                     # required for MinIO

# ── iSIMS import (PRC-01) ───────────────────────────────────────────────────
ISIMS_CSV_PATH=/var/lib/psms/isims-drop      # nightly drop directory
ISIMS_IMPORT_CRON=0 2 * * *                  # 02:00 daily

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_SIGNIN_PER_IP_PER_5MIN=5
RATE_LIMIT_MAGICLINK_ISSUE_PER_HOUR=20

# ── Frontend (apps/web) ─────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1
